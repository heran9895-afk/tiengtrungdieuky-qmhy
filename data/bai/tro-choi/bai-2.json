    "py": "qǐngwèn",
    "why": "请问 (qǐngwèn): xin hỏi. Ví dụ: 请问，您叫什么名字？ Xin hỏi, thầy/cô tên là gì ạ?"
   },
   "你": {
    "py": "nǐ",
    "why": "你 (nǐ): bạn, anh, chị. Ví dụ: 你同学叫什么名字？ Bạn học của bạn tên là gì?"
   },
   "叫": {
    "py": "jiào",
    "why": "叫 là gọi, tên là. Câu hỏi tên: 你叫什么名字？"
   },
   "什么": {
    "py": "shénme",
    "why": "什么 là gì, cái gì, dùng để hỏi: 叫什么？"
   },
   "名字": {
    "py": "míngzi",
    "why": "名字 là cái tên (danh từ). 叫 là động từ \"tên là\"."
   },
   "我": {
    "py": "wǒ",
    "why": "我 là tôi, gồm 手 và 戈. Thêm 们 thành 我们 (chúng tôi)."
   },
   "不": {
    "py": "bù",
    "why": "不 (bù): không. Ví dụ: 我不是老师，我是学生。 Tôi không phải giáo viên, tôi là học sinh."
   },
   "是": {
    "py": "shì",
    "why": "是 là \"là\", nối A với B: 我是学生。"
   },
   "对不起": {
    "py": "duìbuqǐ",
    "why": "对不起 (duìbuqǐ): xin lỗi. Ví dụ: 老师，对不起您。 Thưa thầy/cô, em xin lỗi ạ."
   },
   "没关系": {
    "py": "méi guānxi",
    "why": "没关系 (méi guānxi): không sao, không có gì."
   },
   "没事": {
    "py": "méishì",
    "why": "没事 (méishì): không sao, ổn mà."
   },
   "很": {
    "py": "hěn",
    "why": "很 (hěn): rất. Ví dụ: 我老师很好。 Thầy/cô của tôi rất tốt."
   },
   "高兴": {
    "py": "gāoxìng",
    "why": "高兴 (gāoxìng): vui, vui mừng. Ví dụ: 很高兴认识你。 Rất vui được làm quen với bạn."
   },
   "认识": {
    "py": "rènshi",
    "why": "认识 (rènshi): quen biết, nhận biết. Ví dụ: 我认识你。 Tôi biết bạn."
   },
   "也": {
    "py": "yě",
    "why": "也 (yě): cũng. Ví dụ: 我也很高兴认识你。 Tôi cũng rất vui được làm quen với bạn."
   },
   "我们": {
    "py": "wǒmen",
    "why": "我们 là chúng tôi, chúng ta: 我 thêm 们 thành số nhiều."
   },
   "问": {
    "py": "wèn",
    "why": "问 (wèn): hỏi. Ví dụ: 学生问我：“请问，您是不是王老师？” Học sinh hỏi tôi: “Xin hỏi, cô có phải là cô Vương không ạ?”"
   },
   "请": {
    "py": "qǐng",
    "why": "请 (qǐng): mời; xin (lịch sự). Ví dụ: 王老师，您好！请进！ Chào cô Vương! Mời cô vào!"
   },
   "进": {
    "py": "jìn",
    "why": "进 (jìn): vào. Ví dụ: 请进！ Mời vào!"
   },
   "坐": {
    "py": "zuò",
    "why": "坐 (zuò): ngồi. Ví dụ: 请坐！ Mời ngồi!"
   },
   "说": {
    "py": "shuō",
    "why": "说 (shuō): nói. Ví dụ: 你说什么？ Bạn nói gì?"
   },
   "只": {
    "py": "zhǐ",
    "why": "只 (zhǐ): chỉ. Ví dụ: 我只认识你，不认识陈天中。 Tôi chỉ quen bạn, không quen Trần Thiên Trung."
   },
